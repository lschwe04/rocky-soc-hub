groups:
  - name: backup_alerts
    rules:
      - alert: BackupTargetDown
        expr: up{job="rocky-immutable-backup-lab"} == 0
        for: 5m
        labels:
          severity: critical
        annotations:
          summary: "Backup-Lab Server ist nicht erreichbar!"
          description: "Der Prometheus-Scrape für das Backup-Lab schlägt seit über 5 Minuten fehl."

      - alert: ResticBackupStale
        expr: time() - restic_last_backup_timestamp > 86400
        for: 15m
        labels:
          severity: warning
        annotations:
          summary: "Kein erfolgreiches Backup in den letzten 24 Stunden!"
          description: "Der Zeitstempel des letzten Restic-Backups ist älter als 24 Stunden."

  - name: pipeline_alerts
    rules:
      - alert: LokiDown
        expr: up{job="loki-health"} == 0
        for: 3m
        labels:
          severity: critical
        annotations:
          summary: "Loki Log-Aggregator ist offline!"
          description: "Prometheus kann Loki nicht mehr lokal erreichen."
          
      - alert: PromtailNodeDown
        expr: up{job="promtail-health"} == 0
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "Promtail sendet keine Telemetrie!"
          description: "Der Promtail-Agent auf dem Node 10.100.0.2 antwortet nicht mehr."
