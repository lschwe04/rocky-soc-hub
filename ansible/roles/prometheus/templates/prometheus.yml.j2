global:
  scrape_interval: 15s
  evaluation_interval: 15s

rule_files:
  - '/etc/prometheus/alert_rules.yml'

# FIX: Remote-Write für Langzeit-Retention und externen Ausfallspeicher
remote_write:
  - url: "https://mimir.enterprise-soc.internal/api/v1/push"
    tls_config:
      ca_file: /etc/prometheus/certs/ca.crt
      cert_file: /etc/prometheus/certs/client.crt
      key_file: /etc/prometheus/certs/client.key

scrape_configs:
  - job_name: 'soc-hub-self'
    static_configs:
      - targets: ['localhost:9090']

  - job_name: 'loki-health'
    static_configs:
      - targets: ['localhost:3100']

  - job_name: 'rocky-immutable-backup-lab'
    static_configs:
      - targets: ['{{ backup_lab_ip }}:9100']

  - job_name: 'rocky-soc-node'
    static_configs:
      - targets: ['10.100.0.2:9100']

  - job_name: 'promtail-health'
    static_configs:
      - targets: ['10.100.0.2:9080']
