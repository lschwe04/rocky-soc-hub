global:
  scrape_interval: 15s
  evaluation_interval: 15s

# NEU: Einbindung der Alert-Rules
rule_files:
  - '/etc/prometheus/alert_rules.yml'

scrape_configs:
  - job_name: 'soc-hub-self'
    static_configs:
      - targets: ['localhost:9090']

  - job_name: 'rocky-immutable-backup-lab'
    static_configs:
      - targets: ['{{ backup_lab_ip }}:9100']

  - job_name: 'rocky-soc-node'
    static_configs:
      - targets: ['10.100.0.2:9100']
